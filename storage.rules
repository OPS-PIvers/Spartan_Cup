rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for badge images
    // Write access allowed because admin authentication is handled by Google Apps Script
    match /badges/{imageFile} {
      allow read: if true;  // Anyone can view badges
      allow write: if true; // Allow writes (admin access controlled by Apps Script)
    }

    // Block all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
